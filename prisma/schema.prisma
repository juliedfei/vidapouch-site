enum VidaPouchInventoryBottleStatus {
  QUARANTINED
  AVAILABLE
  LOW_STOCK
  DEPLETED
  EXPIRED
  RECALLED
  DISCARDED
}

enum VidaPouchInventoryMovementType {
  RECEIVED
  RESERVED
  RELEASED
  CONSUMED
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DISCARDED
  RECALL_HOLD
}

model VidaPouchInventoryProduct {
  id String @id @default(cuid())

  /**
   * Stable identity for this product inside the
   * VidaPouch inventory system.
   * Example:
   * "thorne|magnesium-bisglycinate|90-capsules"
   */
  normalizedKey String @unique

  productName String
  brand       String

  dosage    String?
  form      String?
  unitLabel String

  /**
   * Optional connection back to the marketplace
   * product identity used by VidaSearch.
   */
  shoppingProductId String?

  /**
   * Allows an inventory product to remain in
   * historical records even if VidaPouch stops
   * purchasing it.
   */
  active Boolean @default(true)

  /**
   * Quantity at which the admin inventory screen
   * should flag this product for reordering.
   */
  reorderThreshold Decimal? @db.Decimal(10, 2)

  notes String?

  bottles VidaPouchInventoryBottle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([productName])
  @@index([shoppingProductId])
  @@index([active])
}

model VidaPouchInventoryBottle {
  id String @id @default(cuid())

  /**
   * VidaPouch's internal bottle identifier.
   * Example:
   * VP-BTL-000127
   */
  bottleCode String @unique

  inventoryProductId String
  inventoryProduct   VidaPouchInventoryProduct @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)

  /**
   * Manufacturer traceability information.
   */
  manufacturerLotNumber String?
  expirationDate        DateTime?

  /**
   * Where this specific bottle was purchased.
   */
  supplier            String?
  supplierOrderNumber String?

  purchaseDate DateTime?
  receivedAt   DateTime  @default(now())
  openedAt     DateTime?

  status VidaPouchInventoryBottleStatus @default(QUARANTINED)

  /**
   * Actual acquisition cost for this specific bottle.
   */
  bottleCost Decimal @db.Decimal(10, 2)

  allocatedShippingCost Decimal @default(0) @db.Decimal(10, 2)
  allocatedTaxCost      Decimal @default(0) @db.Decimal(10, 2)

  /**
   * bottleCost + allocated shipping + allocated tax.
   * This is stored historically rather than recalculated
   * from today's retail price.
   */
  landedCost Decimal @db.Decimal(10, 2)

  /**
   * Quantities are decimal rather than integer so the
   * system can support products whose usable unit may
   * eventually involve fractional servings.
   */
  originalUnitCount Decimal @db.Decimal(10, 2)

  remainingUnitCount Decimal @db.Decimal(10, 2)

  reservedUnitCount Decimal @default(0) @db.Decimal(10, 2)

  storageLocation String?

  notes String?

  movements   VidaPouchInventoryMovement[]
  allocations VidaPouchInventoryAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryProductId])
  @@index([status])
  @@index([manufacturerLotNumber])
  @@index([expirationDate])
  @@index([receivedAt])
}

model VidaPouchInventoryMovement {
  id String @id @default(cuid())

  bottleId String
  bottle   VidaPouchInventoryBottle @relation(fields: [bottleId], references: [id], onDelete: Restrict)

  movementType VidaPouchInventoryMovementType

  /**
   * Always store quantity as a positive number.
   * movementType determines whether inventory is
   * entering, leaving, being reserved, or released.
   */
  quantity Decimal @db.Decimal(10, 2)

  /**
   * These fields allow us to connect a movement to
   * an order, fulfillment run, adjustment, recall,
   * or another future business record without
   * weakening the inventory audit trail.
   */
  referenceType String?
  referenceId   String?

  reason String?

  createdBy String?

  createdAt DateTime @default(now())

  @@index([bottleId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum VidaPouchFulfillmentRunStatus {
  PENDING
  INVENTORY_RESERVED
  ASSEMBLING
  COMPLETED
  CANCELED
}

model VidaPouchFulfillmentRun {
  id String @id @default(cuid())

  /**
   * The customer order this fulfillment belongs to.
   * A one-time order will normally have one fulfillment run.
   * A subscription may have a new fulfillment run for each
   * monthly billing cycle.
   */
  orderId String
  order   VidaPouchOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /**
   * Subscription renewals can point to the exact billing
   * cycle that caused this fulfillment.
   * This remains null for a normal one-time order.
   */
  billingCycleId String?                @unique
  billingCycle   VidaPouchBillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: Restrict)

  status VidaPouchFulfillmentRunStatus @default(PENDING)

  /**
   * Actual customer revenue associated with this
   * fulfillment occurrence. We snapshot it here so
   * historical profitability does not change later.
   */
  revenueAmount Decimal @db.Decimal(10, 2)

  currency String @default("usd")

  inventoryReservedAt DateTime?
  assemblingAt        DateTime?
  completedAt         DateTime?
  canceledAt          DateTime?

  notes String?

  allocations VidaPouchInventoryAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model VidaPouchInventoryAllocation {
  id String @id @default(cuid())

  fulfillmentRunId String
  fulfillmentRun   VidaPouchFulfillmentRun @relation(fields: [fulfillmentRunId], references: [id], onDelete: Restrict)

  /**
   * The exact supplement line from the customer's
   * VidaPouch order.
   */
  orderItemId String
  orderItem   VidaPouchOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  /**
   * The exact physical source bottle used.
   */
  bottleId String
  bottle   VidaPouchInventoryBottle @relation(fields: [bottleId], references: [id], onDelete: Restrict)

  /**
   * Number of units taken from this bottle for this
   * customer fulfillment.
   */
  quantity Decimal @db.Decimal(10, 2)

  /**
   * Historical cost snapshot.
   * Example:
   * Bottle landed cost = $30
   * Bottle units = 90
   * unitCostSnapshot = $0.333333
   * Once this allocation exists, later bottle-price
   * changes cannot alter the historical order profit.
   */
  unitCostSnapshot Decimal @db.Decimal(12, 6)

  totalCostSnapshot Decimal @db.Decimal(10, 2)

  reservedAt DateTime  @default(now())
  consumedAt DateTime?
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fulfillmentRunId])
  @@index([orderItemId])
  @@index([bottleId])
  @@index([createdAt])
}
